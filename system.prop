# Audio
audio.offload.min.duration.secs=30
af.resampler.quality=7 
audio.sys.noisy.broadcast.delay=600
audio.sys.offload.pstimeout.secs=3
ro.audio.usb.period_us=20375 
ro.audio.resampler.psd.stopband=144
ro.audio.resampler.psd.halflength=48 
ro.audio.resampler.psd.cutoff_percent=100 
ro.audio.resampler.psd.tbwcheat=0 
ro.audio.resampler.psd.enable_at_samplerate=44100
ro.qc.sdk.audio.fluencetype=none
ro.qc.sdk.audio.ssr=false
persist.bluetooth.sbc_hd_higher_bitrate=1

# Adaptive Suspend
suspend.short_suspend_threshold_millis=5000

# Battery
ro.config.small_battery=true

# Camera
camera.disable_zsl_mode=true

# CNE
persist.vendor.cne.feature=1

# Disable MTE Async for system server
persist.arm64.memtag.system_server=off

# Dalvik
dalvik.vm.systemuicompilerfilter=speed 
dalvik.vm.systemservercompilerfilter=speed
dalvik.vm.foreground-heap-growth-multiplier=1.0
dalvik.vm.enable_time_based_gc_trigger=true
dalvik.vm.usejit=true
dalvik.vm.jitmaxsize=512m
dalvik.vm.jitinitialsize=64m
dalvik.vm.jitthreshold=5000
dalvik.vm.jitwarmupthreshold=2500
dalvik.vm.jitpthreadpriority=8
dalvik.vm.parallel-image-loading=true
dalvik.vm.madvise.vdexfile.size=104857600
dalvik.vm.madvise.odexfile.size=104857600
dalvik.vm.madvise.artfile.size=0 
dalvik.vm.usap_pool_enabled=false
dalvik.vm.useartservice=true
dalvik.vm.enable_pr_dexopt=true
dalvik.vm.allow_profile_code=true

# Feature flags
persist.sys.fflag.override.settings_enable_monitor_phantom_procs=false

# Graphics
debug.renderengine.backend=skiavkthreaded
debug.sf.latch_unsignaled=0
debug.sf.auto_latch_unsignaled=true
debug.hwui.skia_tracing_enabled=false
debug.hwui.skia_use_perfetto_track_events=false
debug.sf.disable_client_composition_cache=0

# IMS
persist.dbg.volte_avail_ovr=1
persist.dbg.vt_avail_ovr=1
persist.dbg.wfc_avail_ovr=1
persist.vendor.ims.disableADBLogs=1
persist.vendor.ims.disableDebugLogs=1
persist.vendor.ims.disableIMSLogs=1
persist.vendor.ims.disableQXDMLogs=1

# Media
media.stagefright.enable-player=true
media.stagefright.enable-http=true
media.stagefright.enable-aac=true
media.stagefright.enable-qcp=true
media.stagefright.enable-fma2dp=true
media.stagefright.enable-scan=true
media.stagefright.thumbnail.prefer_hw_codecs=true
mmp.enable.3g2=true
media.aac_51_output_enabled=true
vendor.mm.enable.qcom_parser=16777215
persist.mm.enable.prefetch=true
ro.mediacodec.min_sample_rate=7350
ro.mediacodec.max_sample_rate=2822400

# Netmgr
ro.vendor.use_data_netmgrd=true
persist.vendor.data.mode=concurrent

# Radio
persist.sys.fflag.override.settings_network_and_internet_v2=true
rild.libpath=/vendor/lib64/libril-qc-hal-qmi.so
ril.subscription.types=NV,RUIM

# SSR
persist.vendor.ssr.restart_level=ALL_ENABLE

# SOMC
# ro.semc.ms_type_id=PM-1430-BV
# ro.semc.product.device=DQ
# ro.semc.product.model=XQ-DQ72
# ro.semc.product.name=Xperia 1 V
# ro.semc.version.sw_revision=67.0.A.4.51
# ro.semc.version.sw_type=user
# ro.semc.version.sw_variant=GLOBAL-C2

# Vendor
ro.vendor.qti.va_aosp.support=1

# Zygote
# persist.device_config.runtime_native.usap_pool_enabled=true
